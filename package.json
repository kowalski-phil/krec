{
  "name": "krec",
  "productName": "Krec",
  "version": "0.1.0",
  "description": "One-click screen recordings that upload themselves and hand you a share link.",
  "author": "Phil Kowalski",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run typecheck && electron-vite build && electron-builder --win",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
